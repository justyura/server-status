[Unit]
Description=Server Status self-hosted frontend
After=network-online.target mmwx.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
EnvironmentFile=/etc/server-status.env
ExecStart=/usr/local/bin/server-status
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/server-status

[Install]
WantedBy=multi-user.target
